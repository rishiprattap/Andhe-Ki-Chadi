# =========================================================================
# Firebase Configuration for React Frontend - Andhe Ki Chadi
# Copy this file to .env and insert your Firebase Project web credentials.
# These values can be found in Firebase Console > Project Settings > General > Web Apps
# =========================================================================

# 1. Firebase Web App API Key
VITE_FIREBASE_API_KEY=AIzaSyYourActualApiKeyHere

# 2. Firebase Authentication Domain
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# 3. Firebase Realtime Database URL (Crucial for live cane sync)
# Format: https://<your-project-id>-default-rtdb.firebaseio.com
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# 4. Google Cloud / Firebase Project ID
VITE_FIREBASE_PROJECT_ID=your-project-id

# 5. Firebase Storage Bucket
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# 6. Cloud Messaging Sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012

# 7. Web Application ID
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
